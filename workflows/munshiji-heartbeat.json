{
  "name": "MunshiJi — Heartbeat",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "e1000000-0000-4000-8000-000000000001",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -220,
        0
      ]
    },
    {
      "parameters": {
        "url": "={{ $vars.MUNSHIJI_API_URL }}/api/health",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "e1000000-0000-4000-8000-000000000002",
      "name": "Ping /api/health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        20,
        0
      ],
      "notes": "Render's free tier spins the dyno down after ~15 idle minutes, and the next request pays a ~50-second cold start - during finale night that request would land in the middle of another team's slot. A ping every 5 minutes keeps MunshiJi warm all evening for the cost of a GET. Retire this workflow the day the API moves to a paid instance."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Ping /api/health",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Kolkata"
  },
  "pinData": {},
  "tags": [
    {
      "name": "munshiji"
    }
  ]
}
