# ─── MunshiJi configuration ───────────────────────────────────────────────────
# Copy to `.env`. Every credential below is OPTIONAL: with none of them set, the
# entire product runs offline on Local providers (SPEC.md §2.1).

MUNSHIJI_ENV=dev
MUNSHIJI_DB_URL=sqlite:///data/munshiji.db
MUNSHIJI_LOG_LEVEL=INFO

# auto  → use a vendor when its key is present and healthy, else fall back to local
# live  → require vendors (fail loudly) — use only when demoing the real integrations
# local → force fully offline mode
MUNSHIJI_PROVIDER_MODE=auto

# ─── Sarvam AI — Indic voice + LLM ───────────────────────────────────────────
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v3
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=anushka

# ─── Cognee — knowledge-graph memory ─────────────────────────────────────────
COGNEE_API_KEY=
COGNEE_BASE_URL=https://platform.cognee.ai

# ─── n8n — action orchestration ──────────────────────────────────────────────
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=
N8N_WEBHOOK_PREFIX=/webhook

# ─── Product defaults ────────────────────────────────────────────────────────
MUNSHIJI_DEFAULT_LANGUAGE=hi-IN
MUNSHIJI_SEED=20260919
MUNSHIJI_MAX_OUTBOUND_PER_DAY=50
MUNSHIJI_REMINDER_COOLDOWN_DAYS=7
